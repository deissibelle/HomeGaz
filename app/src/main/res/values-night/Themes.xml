<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/background</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/by_orion_small_white</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

</resources>