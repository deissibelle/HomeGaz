    <!-- Advices Screen — Save section: block titles -->
    <string name="advices_eco_tip1_title">Prepare well before lighting</string>
    <string name="advices_eco_tip2_title">Adjust the flame</string>
    <string name="advices_eco_tip3_title">Use the right cookware</string>
    <string name="advices_eco_tip4_title">Optimize cooking</string>
    <string name="advices_eco_tip5_title">Check for leaks</string>

    <!-- Advices Screen — Save section: bullets -->
    <string name="advices_eco_tip1_b1">Prepare all ingredients before lighting the flame.</string>
    <string name="advices_eco_tip1_b2">Never leave the gas on unnecessarily.</string>
    <string name="advices_eco_tip1_b3">Use thawed food (not straight from frozen).</string>

    <string name="advices_eco_tip2_b1">The flame should be blue and steady.</string>
    <string name="advices_eco_tip2_b2">If it\'s yellow/orange → poor combustion = wasted gas.</string>
    <string name="advices_eco_tip2_b3">The flame should not extend past the base of the pot.</string>

    <string name="advices_eco_tip3_b1">Use pots sized to fit the burner.</string>
    <string name="advices_eco_tip3_b2">Prefer flat-bottomed pots.</string>
    <string name="advices_eco_tip3_b3">Always cover the pot while cooking.</string>

    <string name="advices_eco_tip4_b1">Cut food into small pieces.</string>
    <string name="advices_eco_tip4_b2">Turn off the gas a few minutes before the end (residual heat continues cooking).</string>
    <string name="advices_eco_tip4_b3">Use a pressure cooker to reduce cooking time.</string>

    <string name="advices_eco_tip5_b1">A small leak means a big money loss. Tip:</string>
    <string name="advices_eco_tip5_b2">a) Mix water and soap,</string>
    <string name="advices_eco_tip5_b3">b) Apply to the hose and fittings:</string>
    <string name="advices_eco_tip5_b4">→ If bubbles appear, that\'s a sign of a gas leak.</string>

    <!-- Advices Screen — Fires section: block titles -->
    <string name="advices_inc_tip1_title">Correct setup</string>
    <string name="advices_inc_tip2_title">Check the equipment</string>
    <string name="advices_inc_tip3_title">If you smell gas</string>
    <string name="advices_inc_tip4_title">Behaviors to avoid</string>
    <string name="advices_inc_tip5_title">Safe placement</string>

    <!-- Advices Screen — Fires section: bullets -->
    <string name="advices_inc_tip1_b1">Always keep the bottle upright.</string>
    <string name="advices_inc_tip1_b2">Never lay the bottle on its side.</string>
    <string name="advices_inc_tip1_b3">Install it in a well-ventilated place.</string>
    <string name="advices_inc_tip1_b4">Avoid enclosed spaces (cupboards, unventilated kitchens).</string>

    <string name="advices_inc_tip2_b1">Replace the hose at least every 2 years.</string>
    <string name="advices_inc_tip2_b2">Use an approved hose.</string>
    <string name="advices_inc_tip2_b3">Never use a cracked hose.</string>
    <string name="advices_inc_tip2_b4">Check the regulator regularly.</string>

    <string name="advices_inc_tip3_b1">If you smell gas:</string>
    <string name="advices_inc_tip3_b2">Do not light a match or lighter.</string>
    <string name="advices_inc_tip3_b3">Do not touch any switches.</string>
    <string name="advices_inc_tip3_b4">Open doors and windows immediately.</string>
    <string name="advices_inc_tip3_b5">Close the valve on the gas bottle.</string>
    <string name="advices_inc_tip3_b6">Leave the room if necessary.</string>

    <string name="advices_inc_tip4_b1">Never heat the bottle in the sun.</string>
    <string name="advices_inc_tip4_b2">Never expose it to a heat source.</string>
    <string name="advices_inc_tip4_b3">Never repair a hose with tape.</string>
    <string name="advices_inc_tip4_b4">Don\'t let children handle the gas.</string>

    <string name="advices_inc_tip5_b1">Keep the bottle away from: the oven, electrical outlets, flames, and electrical appliances.</string>

    <!-- Advices Screen — Good daily practices -->
    <string name="advices_daily_1">Close the valve after each use.</string>
    <string name="advices_daily_2">Clean the burners regularly.</string>
    <string name="advices_daily_3">Check that the flame is nicely blue.</string>
    <string name="advices_daily_4">Install a gas detector if possible.</string>
    <string name="advices_daily_5">Keep a small fire extinguisher in the kitchen.</string>

